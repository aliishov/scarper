{
  "manifest_version": 3,
  "name": "Multi-platform scraper",
  "version": "2.0.0",
  "description": "Collects posts from X, Facebook, Instagram, TikTok, and news sites",
  "permissions": [
    "activeTab",
    "downloads",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*",
    "*://www.facebook.com/*",
    "*://facebook.com/*",
    "*://www.instagram.com/*",
    "*://instagram.com/*",
    "*://www.tiktok.com/*",
    "*://tiktok.com/*",
    "*://oxu.az/*",
    "*://www.oxu.az/*",
    "*://media.az/*",
    "*://www.media.az/*",
    "*://1news.az/*",
    "*://www.1news.az/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Open scraper panel"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://www.facebook.com/*",
        "*://facebook.com/*",
        "*://www.instagram.com/*",
        "*://instagram.com/*",
        "*://www.tiktok.com/*",
        "*://tiktok.com/*",
        "*://oxu.az/*",
        "*://www.oxu.az/*",
        "*://media.az/*",
        "*://www.media.az/*",
        "*://1news.az/*",
        "*://www.1news.az/*"
      ],
      "js": [
        "core/namespace.js",
        "core/utils.js",
        "core/storage.js",
        "core/logger.js",
        "core/navigation.js",
        "core/server.js",
        "core/downloads.js",
        "scrapers/base.js",
        "scrapers/twitter.js",
        "scrapers/facebook.js",
        "scrapers/instagram.js",
        "scrapers/tiktok.js",
        "scrapers/oxu.js",
        "scrapers/media.js",
        "scrapers/one-news.js",
        "core/state-machine.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
